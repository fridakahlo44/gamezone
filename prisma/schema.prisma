generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}



model User {

  id        Int      @id @default(autoincrement())

  username  String   @unique

  email     String   @unique

  password  String

  avatar    String   @default("🎮")

  coins     Int      @default(10000)

  level     Int      @default(1)

  xp        Int      @default(0)

  createdAt DateTime @default(now())

}